<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" href="/favicon.ico">

    <title>Saved Advices | Tech Portal</title>
    <style>
        body {
            background-color: #050505;
            background-image: 
                linear-gradient(rgba(14, 165, 233, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14, 165, 233, 0.05) 1px, transparent 1px);
            background-size: 30px 30px;
        }
    </style>
</head>
<body class="min-h-screen font-sans text-slate-300 pb-10">

    <!-- Navbar Include -->
    <%- include("nav.ejs") %>

    <main class="max-w-5xl mx-auto px-4 mt-10">
        <!-- Header -->
        <div class="mb-8 border-b border-sky-500/20 pb-4">
            <h1 class="text-2xl font-bold text-white tracking-widest font-mono">SAVED_FAVORITES</h1>
            <p class="text-sky-500/60 text-xs font-mono mt-1 uppercase tracking-widest">
                Your archived advice collection
            </p>
        </div>

        <!-- Saved Advices Grid -->
        <% if (savedAdvices && savedAdvices.length > 0) { %>
            <div id="faves-grid" class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <% savedAdvices.forEach((item, index) => { %>
                    <div id="advice-card-<%= item.id %>" class="bg-[#121824] border border-emerald-500/40 p-6 rounded-xl text-sky-300 font-mono text-sm shadow-[0_0_15px_rgba(16,185,129,0.15)] transition-all duration-300 hover:-translate-y-1 relative group">
                        
                        <!-- Header Row: Record ID & Date -->
                        <div class="flex justify-between items-center mb-3 text-xs">
                            <span class="text-emerald-400 font-bold tracking-wider">SAVED_RECORD #<%= index + 1 %></span>
                            <span class="text-slate-500 text-[11px]">
                                <%= new Date(item.saved_at).toLocaleString() %>
                            </span>
                        </div>

                        <!-- Advice Text -->
                        <p class="text-slate-100 text-base leading-relaxed mb-4">
                            "<%= item.advice_text %>"
                        </p>

                        <!-- Delete Button -->
                        <div class="flex justify-end">
                            <button 
                                onclick="deleteSavedAdvice('<%= item.id %>')" 
                                class="px-3 py-1.5 bg-red-950/40 border border-red-500/40 text-red-400 text-xs rounded hover:bg-red-500 hover:text-black transition-all duration-300 flex items-center space-x-1"
                            >
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2.2 2.2 0 0115.938 21H8.062a2.2 2.2 0 01-2.195-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                </svg>
                                <span>DELETE_RECORD</span>
                            </button>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } else { %>
            <!-- Empty state -->
            <div class="bg-[#0a0a0a]/80 border border-slate-800 p-8 rounded-lg text-center font-mono">
                <p class="text-slate-500 text-sm">No saved advices found in database.</p>
                <a href="/dashboard" class="inline-block mt-4 text-xs text-sky-400 hover:text-sky-300 underline">
                    Return to dashboard to click & save some!
                </a>
            </div>
        <% } %>
    </main>

    <!-- Delete Script -->
    <script>
        async function deleteSavedAdvice(id) {
            try {
                const response = await fetch("/delete-saved-advice", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ id: id })
                });

                const data = await response.json();

                if (data.success) {
                    // Smoothly fade out and remove the card from the UI
                    const card = document.getElementById(`advice-card-${id}`);
                    card.style.transition = "all 0.3s ease";
                    card.style.opacity = "0";
                    card.style.transform = "scale(0.95)";
                    setTimeout(() => {
                        card.remove();
                        
                        // If grid is empty now, reload to show empty state message
                        const grid = document.getElementById("faves-grid");
                        if (grid && grid.children.length === 0) {
                            location.reload();
                        }
                    }, 300);
                } else {
                    alert("Failed to delete advice record.");
                }
            } catch (err) {
                console.error("Error connecting to server:", err);
            }
        }
    </script>

</body>
</html>