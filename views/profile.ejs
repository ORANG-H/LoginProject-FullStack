<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" href="/favicon.ico">


    <title>Profile - <%= name %> <%= surname %></title>
</head>
<body class="bg-gray-50 text-gray-900 font-sans">
   
    <!-- Navigation Include -->
    <%- include('nav', { name: name, surname: surname, img: img }) %>
    
    <main class="container mx-auto px-6 py-10 flex flex-col items-center">
        <h1 class="text-4xl font-extrabold text-gray-950 mb-4">Profile Settings</h1>
        <p class="text-gray-700 mb-8 max-w-xl">Update your profile details below. You can change your name, surname, and profile picture.</p>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100 max-w-md w-full">
            <form action="/profile" method="POST" enctype="multipart/form-data" class="flex flex-col space-y-6">
                
                <!-- Name Input -->
                <div class="relative">
                    <label class="absolute -top-2 left-3 bg-white px-1 text-[10px] font-mono text-sky-500 uppercase tracking-wider">Name</label>
                    <input 
                        type="text" 
                        name="name" 
                        value="<%= name %>"
                        class="w-full bg-[#111] border border-slate-800 rounded-md px-4 py-3 text-sky-400 font-mono text-sm placeholder-slate-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all duration-300"
                        required
                    >
                </div>

                <!-- Surname Input -->
                <div class="relative">
                    <label class="absolute -top-2 left-3 bg-white px-1 text-[10px] font-mono text-sky-500 uppercase tracking-wider">Surname</label>
                    <input 
                        type="text" 
                        name="surname" 
                        value="<%= surname %>"
                        class="w-full bg-[#111] border border-slate-800 rounded-md px-4 py-3 text-sky-400 font-mono text-sm placeholder-slate-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all duration-300"
                        required
                    >
                </div>

                <!-- Profile Picture Input -->
                <div class="relative">
                    <label class="absolute -top-2 left-3 bg-white px-1 text-[10px] font-mono text-sky-500 uppercase tracking-wider">Profile Picture</label>
                    <input 
                        type="file" 
                        name="profilePicture" 
                        accept="image/*"
                        class="w-full bg-[#111] border border-slate-800 rounded-md px-4 py-3 text-sky-400 font-mono text-sm placeholder-slate-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all duration-300"
                    >
                </div>      

                <!-- Email Input -->
                <div class="relative">
                    <label class="absolute -top-2 left-3 bg-white px-1 text-[10px] font-mono text-sky-500 uppercase tracking-wider">Email</label>
                    <input 
                        type="email" 
                        name="email" 
                        value="<%= email %>"
                        class="w-full bg-[#111] border border-slate-800 rounded-md px-4 py-3 text-sky-400 font-mono text-sm placeholder-slate-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all duration-300"
                    >
                </div>
 
                <button 
                    type="submit" 
                    class="w-full bg-sky-500 text-white font-semibold px-6 py-3 rounded-lg hover:bg-sky-600 transition"
                >
                    Update Profile
                </button>
            </form>
 
            <form action="/delete-account" method="POST" class="mt-2">
                <button 
                    type="submit" 
                    class="w-full bg-red-600 text-white font-semibold px-6 py-3 rounded-lg hover:bg-red-700 transition"
                >
                    Delete Account
                </button>
            </form>
        </div>
    </main>
</body>
</html>