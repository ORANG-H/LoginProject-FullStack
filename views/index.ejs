<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
<link rel="icon" href="/favicon.ico">

    <title>Login Portal</title>
    <style>
        /* Creates a subtle tech-y grid background */
        body {
            background-color: #050505;
            background-image: 
                linear-gradient(rgba(14, 165, 233, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(14, 165, 233, 0.05) 1px, transparent 1px);
            background-size: 30px 30px;
            background-position: center center;
        }
    </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4 font-sans text-slate-300">

    <!-- Tech Interface Card -->
    <div class="relative w-full max-w-sm bg-[#0a0a0a]/95 backdrop-blur-md border border-sky-500/20 p-8 rounded-lg shadow-[0_0_30px_rgba(14,165,233,0.1)] overflow-hidden">
        
        <!-- Glowing accent line at the top -->
        <div class="absolute top-0 left-0 w-full h-[2px] bg-gradient-to-r from-transparent via-sky-500 to-transparent"></div>

        <div class="text-center mb-8">
            <h1 class="text-2xl font-bold text-white tracking-widest font-mono">LOGIN </h1>
            <p class="text-sky-500/60 text-xs font-mono mt-2 uppercase tracking-widest">Authenticate to continue</p>
        </div>
        
        <form action="/login" method="POST" class="flex flex-col space-y-6">
            
            <!-- Email Input -->
            <div class="relative">
                <label class="absolute -top-2 left-3 bg-[#0a0a0a] px-1 text-[10px] font-mono text-sky-500 uppercase tracking-wider">Email</label>
                <input 
                    type="email" 
                    name="email" 
                    class="w-full bg-[#111] border border-slate-800 rounded-md px-4 py-3 text-sky-400 font-mono text-sm placeholder-slate-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all duration-300"
                    placeholder="admin@example.com"
                    required
                >
            </div>
            
            <!-- Password Input -->
            <div class="relative">
                <label class="absolute -top-2 left-3 bg-[#0a0a0a] px-1 text-[10px] font-mono text-sky-500 uppercase tracking-wider">Password</label>
                <input 
                    type="password" 
                    name="password" 
                    class="w-full bg-[#111] border border-slate-800 rounded-md px-4 py-3 text-sky-400 font-mono text-sm placeholder-slate-700 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all duration-300"
                    placeholder="••••••••"
                    required
                >
            </div>

            <!-- Tech Submit Button -->

            <!-- ERROR BOX (Only shows if an error exists) -->
<% if (locals.error && error) { %>
    <div class="bg-red-950/40 border border-red-500/50 text-red-400 px-4 py-3 rounded-md text-xs font-mono mb-6 flex items-center shadow-[0_0_15px_rgba(239,68,68,0.1)]">
        <svg class="w-4 h-4 mr-2 flex-shrink-0 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
        </svg>
        <span><%= error %></span>
    </div>
<% } %>


            <button 
                type="submit" 
                class="relative w-full flex justify-center items-center py-3 px-4 border border-sky-500/50 text-sm font-mono font-bold tracking-widest rounded-md text-sky-400 bg-sky-900/10 hover:bg-sky-500 hover:text-black focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-[#0a0a0a] focus:ring-sky-500 transition-all duration-300 group mt-2"
            >
                <span class="absolute left-0 w-1 h-full bg-sky-500 group-hover:bg-black transition-colors duration-300"></span>
                <span>LOGIN!</span>
                <svg class="ml-3 w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                </svg>
            </button>
            
        </form>
        
        <!-- Footer link -->
         <form action="/register" method="GET" class="mt-4">
            <div class="mt-6 text-center text-slate-500 text-xs font-mono tracking-widest">
                <a href="/register" class="text-[11px] font-mono text-slate-500 hover:text-sky-400 transition-colors">Register</a>
            </div>
        </form>

    </div>

</body>
</html>